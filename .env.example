# --- database (shared by the shop core and by the supplier stubs) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shop
DB_USER=shop
DB_PASS=shop

# --- shop core ---
APP_URL=http://localhost:8000
SUPPLIER_A_URL=http://127.0.0.1:9001
SUPPLIER_B_URL=http://127.0.0.1:9002
# --- supplier calls (stage 3) ---
DELIVERY_CONNECT_TIMEOUT_SEC=2
# total time budget per call; exceeding it makes the attempt 'unknown', not 'failed'
DELIVERY_TIMEOUT_SEC=5
# attempts per supplier, all under the same request_id; only 'unknown' is retried
DELIVERY_MAX_ATTEMPTS=4
# exponential backoff with full jitter between those attempts
DELIVERY_BACKOFF_BASE_MS=200
DELIVERY_BACKOFF_CAP_MS=5000

# --- delivery worker ---
# orders / events picked per pass
WORKER_BATCH=20
# idle pause when a pass found nothing to do
WORKER_SLEEP_MS=200

# --- recovery (stage 4) ---
# how long an order must sit still in delivery_failed / out_of_stock before recovery takes it;
# also acts as the backoff, since a failed recovery pass bumps updated_at
RECOVERY_DELAY_SEC=30
# how often the worker runs the recovery scan at all
RECOVERY_INTERVAL_SEC=5
# how long after the payment a line that still cannot be delivered gets refunded;
# must be comfortably larger than RECOVERY_DELAY_SEC so recovery gets its chances first
REFUND_AFTER_SEC=300
# age after which reconcile reports an order as "paid but not delivered"
RECONCILE_STALE_MIN=5
# how long a reserved key may sit unattached before the audit looks at it
AUDIT_GRACE_SEC=60

# --- supplier pacing (stage 2, task 3) ---
# how many issue calls per minute we allow ourselves per supplier; 0 means no pacing.
# keep it at or below the supplier's own RATE_LIMIT_PER_MIN.
SUPPLIER_RATE_LIMIT_PER_MIN=0
# per-supplier override, e.g. SUPPLIER_A_RATE_LIMIT_PER_MIN=30

# --- supplier stubs (set per process, see Makefile target `suppliers`) ---
SUPPLIER_NAME=A
# share of requests answered with 5xx BEFORE anything is issued, 0..1
FAIL_RATE=0
# share of requests that hang for TIMEOUT_SEC before answering, 0..1
TIMEOUT_RATE=0
TIMEOUT_SEC=10
# calls per minute the stub accepts on POST /issue; 0 means no limit
RATE_LIMIT_PER_MIN=0
# --- dishonest supplier (stage 2, task 2) ---
# reserve the key, commit it, then answer 5xx anyway
ERROR_AFTER_ISSUE_RATE=0
# answer with a code that was already issued to somebody else
DUPLICATE_RATE=0
# answer with a code that was never in this pool
FOREIGN_CODE_RATE=0
